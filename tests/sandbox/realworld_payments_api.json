{
  "openapi": "3.0.3",
  "info": {
    "title": "Stripe-Grade Global Payments & Invoicing Platform API",
    "version": "2026-09-01",
    "description": "Enterprise payment processing platform supporting multi-currency charges, recurring subscriptions, invoice reconciliation, and localized tax calculations."
  },
  "servers": [
    { "url": "https://api.payments-corp.com/v3" }
  ],
  "paths": {
    "/v3/customers": {
      "post": {
        "summary": "Create Customer",
        "description": "Creates a new customer profile. Required before attaching payment methods or creating subscriptions.",
        "operationId": "createCustomer",
        "tags": ["Customers"],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique UUIDv4 idempotency key to prevent duplicate customer creation.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "name", "country_code"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "name": { "type": "string" },
                  "country_code": { "type": "string", "description": "ISO-3166-1 alpha-2" },
                  "tax_exempt": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "example": "cus_998877" },
                    "email": { "type": "string" },
                    "created_at": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation failed: Invalid email or country code." },
          "409": { "description": "Customer already exists with this idempotency key." }
        }
      }
    },
    "/v3/checkout/sessions": {
      "post": {
        "summary": "Create Checkout Session",
        "description": "Spins up a hosted payment checkout session. Supersedes legacy v1 charges endpoint.",
        "operationId": "createCheckoutSession",
        "tags": ["Checkout", "Payments"],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Mandatory idempotency key.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer_id", "currency", "line_items", "success_url", "cancel_url"],
                "properties": {
                  "customer_id": { "type": "string", "description": "Must match cus_[a-zA-Z0-9]+" },
                  "currency": { "type": "string", "enum": ["usd", "eur", "gbp", "jpy"] },
                  "line_items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["price_id", "quantity"],
                      "properties": {
                        "price_id": { "type": "string" },
                        "quantity": { "type": "integer", "minimum": 1 }
                      }
                    }
                  },
                  "success_url": { "type": "string" },
                  "cancel_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "url": { "type": "string" },
                    "payment_status": { "type": "string", "enum": ["unpaid", "paid"] }
                  }
                }
              }
            }
          },
          "400": { "description": "Missing customer_id or invalid line item." },
          "409": { "description": "Concurrent checkout locked for this customer." },
          "429": { "description": "Rate limit exceeded (Max 50 req/sec per API key)." }
        }
      }
    },
    "/v3/subscriptions": {
      "post": {
        "summary": "Create Recurring Subscription",
        "description": "Enrolls a customer into an automated recurring billing cycle.",
        "operationId": "createSubscription",
        "tags": ["Subscriptions", "Billing"],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer_id", "plan_id"],
                "properties": {
                  "customer_id": { "type": "string" },
                  "plan_id": { "type": "string" },
                  "trial_period_days": { "type": "integer", "default": 0 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Subscription active." },
          "402": { "description": "Payment Required: Card declined or insufficient funds." }
        }
      }
    },
    "/v3/webhooks/verify": {
      "post": {
        "summary": "Verify Webhook Signature",
        "description": "Cryptographically validates incoming webhook payload signatures.",
        "operationId": "verifyWebhookSignature",
        "tags": ["Webhooks", "Security"],
        "parameters": [
          { "name": "X-Signature-SHA256", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "X-Timestamp", "in": "header", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Signature valid." },
          "401": { "description": "Signature invalid or timestamp drift exceeds 300 seconds." }
        }
      }
    }
  }
}
